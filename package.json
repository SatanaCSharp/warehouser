{
  "name": "warehouser",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "node --test tests/**/*.spec.mjs && turbo run test",
    "test:auth-release": "node --test tests/auth/release-gates.spec.mjs",
    "test:access-release": "node --test tests/access/*.spec.mjs",
    "test:users-release": "node --test tests/users/*.spec.mjs",
    "test:workspaces-release": "node --test tests/workspaces/*.spec.mjs",
    "clean": "turbo run clean",
    "prepare": "husky",
    "lint:all": "oxlint --type-aware --max-warnings=0 ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@warehouser/oxlint-config": "workspace:*",
    "eslint-plugin-no-relative-import-paths": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "^3.9.5",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
