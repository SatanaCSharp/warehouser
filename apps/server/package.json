{
  "name": "@warehouser/server",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.pglite.config.cjs",
    "test:architectural": "jest --config jest.architectural.config.cjs",
    "test:all": "pnpm test && pnpm test:architectural && pnpm test:integration",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/shared/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/database/data-source.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/jwt": "catalog:",
    "@nestjs/passport": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/typeorm": "catalog:",
    "@warehouser/contracts": "workspace:*",
    "@warehouser/shared-types": "workspace:*",
    "@warehouser/utils": "workspace:*",
    "bullmq": "catalog:",
    "lodash": "^4.18.1",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "passport": "catalog:",
    "passport-jwt": "catalog:",
    "passport-local": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "pino-pretty": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typeorm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/jest": "catalog:",
    "@types/lodash": "^4.17.24",
    "@types/passport-jwt": "catalog:",
    "@types/passport-local": "catalog:",
    "@warehouser/eslint-config-service": "workspace:*",
    "@warehouser/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-morph": "^28.0.0",
    "ts-node": "catalog:",
    "typeorm-pglite": "^0.3.4"
  }
}
