{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // Every package's `.oxlintrc.json` `extends` the root one, and a package's own file list — which
  // is what turbo hashes by default — cannot see it. Without this, editing the shared lint baseline
  // would leave every `lint` task reporting a cache hit against the old rules.
  "globalDependencies": [".oxlintrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    // `^build` is still required: the type-aware pass reads dependencies' emitted `.d.ts` files.
    // `inputs` is deliberately left at turbo's default (everything git-tracked in the package), so
    // a change to a package's own `.oxlintrc.json`, `tsconfig.json` or `package.json` invalidates
    // its lint cache without anyone having to remember to list it.
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
