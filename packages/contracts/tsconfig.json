{
  "extends": "@warehouser/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "src",
    "paths": { "*": ["./src/*"] },
    "outDir": "dist",
    // Stated rather than left to TypeScript's automatic `@types` discovery. `tsc` finds
    // `node_modules/@types/node` on its own here, but `oxlint --type-aware` runs its checks through
    // `oxlint-tsgolint`, whose discovery does not follow pnpm's symlinked `@types` directory — so
    // without this line the type-aware pass sees `setTimeout`/`__dirname`/`node:fs` as `error`
    // types and every `no-unsafe-*` rule fires on them. `@types/node` is this package's only
    // ambient type dependency, so naming it changes nothing for `tsc`.
    "types": ["node"]
  },
  // What lets this package's source stay extensionless while its output is loadable ESM. Node's
  // ESM resolver does no extension search and no directory resolution, so `dist/` must name
  // `./items-projections.js` and `../items/index.js` outright — but `moduleResolution: "Bundler"`
  // in the shared base config lets `tsc` accept the bare `items/items-projections` and `items` the
  // source actually writes. `tsc-alias` closes the gap: it already rewrites the `paths` aliases
  // into relative specifiers, and `resolveFullPaths` has it append the extension too, resolved
  // against the emitted tree rather than guessed — a directory becomes `/index.js`, and a
  // non-relative specifier is left alone, which is why `@warehouser/shared-types/enums` survives
  // untouched.
  "tsc-alias": { "resolveFullPaths": true },
  "include": ["src/**/*.ts"]
}
