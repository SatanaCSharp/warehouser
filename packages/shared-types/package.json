{
  "name": "@warehouser/shared-types",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "exports": {
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "start:dev": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "lint:fix": "oxlint --type-aware --fix src && oxlint --type-aware --max-warnings=0 src",
    "test": "vitest run",
    "crap": "CRAP=1 vitest run"
  },
  "devDependencies": {
    "@barney-media/crap-typescript-vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@warehouser/oxlint-config": "workspace:*",
    "@warehouser/tsconfig": "workspace:*",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
