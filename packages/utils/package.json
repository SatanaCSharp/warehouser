{
  "name": "@warehouser/utils",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "",
  "type": "commonjs",
  "engines": {
    "node": ">=24.14.0"
  },
  "exports": {
    "./asserts": {
      "types": "./dist/asserts/index.d.ts",
      "default": "./dist/asserts/index.js"
    },
    "./predicates": {
      "types": "./dist/predicates/index.d.ts",
      "default": "./dist/predicates/index.js"
    },
    "./type-guards": {
      "types": "./dist/type-guards/index.d.ts",
      "default": "./dist/type-guards/index.js"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "default": "./dist/async/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "start:dev": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "lint": "oxlint --type-aware --max-warnings=0 src",
    "lint:fix": "oxlint --type-aware --fix src && oxlint --type-aware --max-warnings=0 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@warehouser/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@warehouser/tsconfig": "workspace:*",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
